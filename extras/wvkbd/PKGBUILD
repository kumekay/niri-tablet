# Local package: wvkbd from the maintained upstream (proycon's fork), which
# includes the Super modifier key on deskintl. The AUR wvkbd-git builds the
# stale jjsullivan5196 repo, which lacks it.
# Also builds the mobintl variant (mobile layers) alongside deskintl.
# deskintl-no-fkeys.patch drops the Esc/F1-F12/Del row from the full and
# cyrillic layers; Esc moves to the start of the number row and Cmp to the
# right Ctrl's place.
# niri-keymap.patch uploads niri's keymap (Colemak + Russian) instead of
# wvkbd's QWERTY one and maps the QWERTY key codes to Colemak. Then apps
# that open while the keyboard is up still get the right letters.
# It also fixes keys in the Cmp layers that typed the wrong symbol
# (Cmp+. ?, Cmp+9 < and >).
pkgname=wvkbd-touch
pkgver=r287.bbecd99
pkgrel=7
pkgdesc='On-screen keyboard for wlroots (maintained upstream, with Super key)'
url='https://git.sr.ht/~proycon/wvkbd'
arch=('x86_64' 'aarch64')
license=('GPL3')
depends=('wayland' 'pango' 'cairo' 'glibc')
makedepends=('git' 'fontconfig' 'libxkbcommon' 'scdoc')
provides=('wvkbd' 'wvkbd-git')
conflicts=('wvkbd' 'wvkbd-git')
source=("git+https://git.sr.ht/~proycon/wvkbd"
        'deskintl-no-fkeys.patch'
        'niri-keymap.patch')
sha256sums=('SKIP'
            '2ed3d9b4aed0b1fcf96c44d776722e480d1790362cbbaede7f9de65a5e054c32'
            '80fe0c37e5bc26603d0c252346a85f4b1cb4572100c40d4eb6d06ff14cd9058d')

pkgver() {
  cd wvkbd
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd wvkbd
  # A previous build's patch may still be applied.
  git reset --hard
  patch -Np1 < "$srcdir/deskintl-no-fkeys.patch"
  patch -Np1 < "$srcdir/niri-keymap.patch"
}

build() {
  cd wvkbd
  make LAYOUT=deskintl
  make LAYOUT=mobintl
}

package() {
  cd wvkbd
  make LAYOUT=deskintl PREFIX=/usr DESTDIR="$pkgdir" install
  make LAYOUT=mobintl PREFIX=/usr DESTDIR="$pkgdir" install
}
