 #include KEYMAP
 
+/* Upload the same keymap niri uses (Colemak + Russian as group 2), not
+ * wvkbd's own QWERTY keymap. Apps that open while the keyboard is up get
+ * niri's keymap from the compositor, so wvkbd's key codes must mean the same
+ * thing in both. <COMP> holds the character for Copy keys; U00000000 is
+ * dropped by xkbcommon and <COMP> stays Menu. */
+static const char *niri_keymap =
+    "xkb_keymap {\n"
+    "xkb_keycodes { include \"evdev+aliases(qwerty)\" };\n"
+    "xkb_types { include \"complete\" };\n"
+    "xkb_compat { include \"complete\" };\n"
+    "xkb_symbols {\n"
+    "include \"pc+us(colemak)+ru:2+inet(evdev)\"\n"
+    "key <COMP> { [ U%08X, U%08X ] };\n"
+    "};\n"
+    "};\n";
+
+/* Group 0 = Colemak, group 1 = Russian. */
+static uint32_t
+kbd_group(struct kbd *kb)
+{
+    return strcmp(kb->layout->keymap_name, "cyrillic") == 0;
+}
+
+/* The layouts use QWERTY key codes. In the Colemak group, send the code of
+ * the key that types the letter on the label. */
+static uint32_t
+kbd_code(struct kbd *kb, uint32_t code)
+{
+    if (kbd_group(kb))
+        return code;
+    switch (code) {
+    case KEY_E: return KEY_K;
+    case KEY_R: return KEY_S;
+    case KEY_T: return KEY_F;
+    case KEY_Y: return KEY_O;
+    case KEY_U: return KEY_I;
+    case KEY_I: return KEY_L;
+    case KEY_O: return KEY_SEMICOLON;
+    case KEY_P: return KEY_R;
+    case KEY_S: return KEY_D;
+    case KEY_D: return KEY_G;
+    case KEY_F: return KEY_E;
+    case KEY_G: return KEY_T;
+    case KEY_J: return KEY_Y;
+    case KEY_K: return KEY_N;
+    case KEY_L: return KEY_U;
+    case KEY_SEMICOLON: return KEY_P;
+    case KEY_N: return KEY_J;
+    default: return code;
+    }
+}
